# Copiar a .env.local para desarrollo local. En Vercel se cargan en
# Project Settings > Environment Variables. NUNCA subir .env.local a GitHub.

# --- Firebase cliente (Configuración del proyecto > Tus apps > App web) — son públicas ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Configuración > Cuentas de servicio > Generar nueva clave privada) — SECRETAS ---
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pegar la clave completa entre comillas, con los \n tal como vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
