# Copiar a .env y completar:   cp .env.example .env
# .env NUNCA se sube al repositorio (está en .gitignore)

# --- Nube ---
# URL pública de la plataforma en Vercel (solo HTTPS)
API_URL=https://TU-PROYECTO.vercel.app
# Token del dispositivo, generado en la plataforma web (pestaña Dispositivos)
DEVICE_TOKEN=pega-aqui-el-token

# --- Hardware (numeración BCM) ---
GPIO_CHIP=/dev/gpiochip0
GPIO_PIR=18
# El DHT en GPIO17 se configura en /boot/firmware/config.txt con:
#   dtoverlay=dht11,gpiopin=17

# --- Valores por defecto (la plataforma web los sobreescribe en caliente) ---
INTERVALO_CLIMA_SEG=10
INTERVALO_ENVIO_SEG=60
CONFIG_POLL_SEG=30

# --- Otros ---
MQTT_HOST=mosquitto
TZ_LOCAL=America/Santiago
